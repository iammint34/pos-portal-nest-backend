// POS Portal Backend - Prisma Schema
// Phase 1: Authentication, RBAC, Stores, Branches, Items, POS, Sync

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// =====================
// User & Authentication
// =====================

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  firstName    String    @map("first_name")
  lastName     String    @map("last_name")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  // Relations
  storeUsers    StoreUser[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  shifts        Shift[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique @db.VarChar(500)
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  isRevoked Boolean  @default(false) @map("is_revoked")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

// =====================
// RBAC - Roles & Permissions
// =====================

model Role {
  id          String    @id @default(uuid())
  name        String
  description String?   @db.Text
  storeId     String    @map("store_id")
  isSystem    Boolean   @default(false) @map("is_system")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  // Relations
  store           Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  storeUsers      StoreUser[]

  @@unique([storeId, name])
  @@index([storeId])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?  @db.Text
  module      String
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  rolePermissions RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// =====================
// Store (Multi-Tenant)
// =====================

enum StoreType {
  RESTAURANT
  RETAIL
  CAFE
  OTHER
}

enum StoreStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Store {
  id        String      @id @default(uuid())
  name      String
  type      StoreType   @default(OTHER)
  status    StoreStatus @default(ACTIVE)
  address   String?     @db.Text
  phone     String?
  email     String?
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  deletedAt DateTime?   @map("deleted_at")

  // BIR Compliance Fields
  registeredName    String?   @map("registered_name") @db.VarChar(255)    // Official BIR-registered business name
  registeredAddress String?   @map("registered_address") @db.Text         // BIR-registered address
  vatTin            String?   @map("vat_tin") @db.VarChar(20)             // VAT Registration TIN (e.g., "123-456-789-000")
  isVatRegistered   Boolean   @default(true) @map("is_vat_registered")   // Is the business VAT registered?

  // Relations
  branches   Branch[]
  storeUsers StoreUser[]
  roles      Role[]
  items      Item[]
  categories Category[]
  auditLogs  AuditLog[]

  @@map("stores")
}

model StoreUser {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  storeId   String    @map("store_id")
  roleId    String    @map("role_id")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  role  Role  @relation(fields: [roleId], references: [id])

  @@unique([userId, storeId])
  @@index([storeId])
  @@index([roleId])
  @@map("store_users")
}

// =====================
// Branches
// =====================

enum BranchStatus {
  ONLINE
  OFFLINE
  MAINTENANCE
}

model Branch {
  id           String       @id @default(uuid())
  storeId      String       @map("store_id")
  name         String
  address      String?      @db.Text
  phone        String?
  status       BranchStatus @default(OFFLINE)
  lastSyncAt   DateTime?    @map("last_sync_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  deletedAt    DateTime?    @map("deleted_at")

  // BIR Compliance Fields - PTU (Permit To Use) info per branch
  ptuNo           String?   @map("ptu_no") @db.VarChar(50)      // Permit To Use Number (e.g., "PTU-1234-567-890")
  ptuDateIssued   DateTime? @map("ptu_date_issued")             // Date PTU was issued
  ptuValidUntil   DateTime? @map("ptu_valid_until")             // PTU expiry date (null = "No Expiry")
  accreditationNo String?   @map("accreditation_no") @db.VarChar(50) // BIR Accreditation Number

  // Relations
  store           Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  posDevices      PosDevice[]
  itemBranches    ItemBranch[]
  branchInventory BranchInventory[]

  @@index([storeId])
  @@map("branches")
}

// =====================
// Items (with Versioning)
// =====================

model Category {
  id          String    @id @default(uuid())
  storeId     String    @map("store_id")
  name        String
  description String?   @db.Text
  sortOrder   Int       @default(0) @map("sort_order")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  // Relations
  store Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items Item[]

  @@unique([storeId, name])
  @@index([storeId])
  @@map("categories")
}

model Item {
  id          String    @id @default(uuid())
  storeId     String    @map("store_id")
  categoryId  String?   @map("category_id")
  sku         String?
  name        String
  description String?   @db.Text
  price       Decimal   @db.Decimal(10, 2)
  isActive    Boolean   @default(true) @map("is_active")
  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  // Relations
  store           Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category        Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  itemBranches    ItemBranch[]
  itemVersions    ItemVersion[]
  orderItems      OrderItem[]
  branchInventory BranchInventory[]

  @@unique([storeId, sku])
  @@index([storeId])
  @@index([categoryId])
  @@map("items")
}

model ItemVersion {
  id          String   @id @default(uuid())
  itemId      String   @map("item_id")
  version     Int
  name        String
  description String?  @db.Text
  price       Decimal  @db.Decimal(10, 2)
  changedBy   String?  @map("changed_by")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, version])
  @@index([itemId])
  @@map("item_versions")
}

model ItemBranch {
  id          String   @id @default(uuid())
  itemId      String   @map("item_id")
  branchId    String   @map("branch_id")
  isAvailable Boolean  @default(true) @map("is_available")
  customPrice Decimal? @db.Decimal(10, 2) @map("custom_price")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([itemId, branchId])
  @@index([branchId])
  @@map("item_branches")
}

// =====================
// POS Device Management
// =====================

enum PosStatus {
  ONLINE
  OFFLINE
  INACTIVE
}

model PosDevice {
  id                        String    @id @default(uuid())
  branchId                  String    @map("branch_id")
  deviceIdentifier          String?   @unique @map("device_identifier")
  name                      String?
  appVersion                String?   @map("app_version")
  status                    PosStatus @default(OFFLINE)
  lastHeartbeatAt           DateTime? @map("last_heartbeat_at")
  lastSyncAt                DateTime? @map("last_sync_at")
  tokenHash                 String?   @map("token_hash")
  tokenExpiresAt            DateTime? @map("token_expires_at")
  // Registration code fields
  registrationCode          String?   @unique @map("registration_code")
  registrationCodeExpiresAt DateTime? @map("registration_code_expires_at")
  isRegistered              Boolean   @default(false) @map("is_registered")
  registeredAt              DateTime? @map("registered_at")
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")
  deletedAt                 DateTime? @map("deleted_at")

  // BIR Compliance Fields
  min               String?   @db.VarChar(50)                            // Machine Identification Number (e.g., "260123-POS-001")
  serialNumber      String?   @map("serial_number") @db.VarChar(50)      // Hardware serial number
  permitNumber      String?   @map("permit_number") @db.VarChar(50)      // BIR permit number for this specific machine

  // Relations
  branch     Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  syncLogs   SyncLog[]
  orders     Order[]
  shifts     Shift[]
  zReadings  ZReading[]

  @@index([branchId])
  @@index([registrationCode])
  @@map("pos_devices")
}

// =====================
// Sync Module
// =====================

enum SyncType {
  CONFIG
  ITEMS
  CATEGORIES
  FULL
  HEARTBEAT
}

enum SyncStatus {
  SUCCESS
  FAILED
  PARTIAL
}

model SyncLog {
  id          String     @id @default(uuid())
  posDeviceId String     @map("pos_device_id")
  syncType    SyncType   @map("sync_type")
  status      SyncStatus
  version     Int?
  itemCount   Int?       @map("item_count")
  errorMsg    String?    @db.Text @map("error_msg")
  startedAt   DateTime   @map("started_at")
  completedAt DateTime?  @map("completed_at")
  createdAt   DateTime   @default(now()) @map("created_at")

  // Relations
  posDevice PosDevice @relation(fields: [posDeviceId], references: [id], onDelete: Cascade)

  @@index([posDeviceId])
  @@index([syncType])
  @@index([createdAt])
  @@map("sync_logs")
}

// =====================
// Audit Logging
// =====================

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  SYNC
  REGISTER
}

model AuditLog {
  id         String      @id @default(uuid())
  userId     String?     @map("user_id")
  storeId    String?     @map("store_id")
  action     AuditAction
  entityType String      @map("entity_type")
  entityId   String?     @map("entity_id")
  oldValue   Json?       @map("old_value")
  newValue   Json?       @map("new_value")
  ipAddress  String?     @map("ip_address")
  userAgent  String?     @db.Text @map("user_agent")
  createdAt  DateTime    @default(now()) @map("created_at")

  // Relations
  user  User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  store Store? @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([storeId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
  @@map("audit_logs")
}

// =====================
// Sales Module (POS → Backend Sync)
// =====================

enum OrderStatus {
  PENDING
  COMPLETED
  VOIDED
  REFUNDED
}

enum OrderType {
  DINE_IN
  TAKEOUT
  DELIVERY
  DRIVE_THRU
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  MOBILE_PAYMENT
  GIFT_CARD
  STORE_CREDIT
  OTHER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum DiscountScope {
  ORDER
  ITEM
}

model Order {
  id              String      @id @default(uuid())
  posOrderId      String      @map("pos_order_id") // Unique ID from POS for idempotency
  posDeviceId     String      @map("pos_device_id")
  branchId        String      @map("branch_id")
  storeId         String      @map("store_id")
  shiftId         String?     @map("shift_id") // Reference to shift this order belongs to
  operatorId      String?     @map("operator_id") // Portal user ID of operator
  posOperatorId   String?     @map("pos_operator_id") // POS operator ID for reference
  orderNumber     String      @map("order_number") // Human-readable order number
  invoiceNumber   String?     @map("invoice_number") // BIR sequential invoice number (e.g., "SI-000001")
  orderType       OrderType   @default(DINE_IN) @map("order_type")
  status          OrderStatus @default(COMPLETED)
  subtotal        Decimal     @db.Decimal(10, 2)
  discountTotal   Decimal     @default(0) @db.Decimal(10, 2) @map("discount_total")
  taxTotal        Decimal     @default(0) @db.Decimal(10, 2) @map("tax_total")
  grandTotal      Decimal     @db.Decimal(10, 2) @map("grand_total")

  // BIR VAT Breakdown
  vatableSales    Decimal     @default(0) @db.Decimal(10, 2) @map("vatable_sales")    // VATable portion (grandTotal / 1.12)
  vatAmount       Decimal     @default(0) @db.Decimal(10, 2) @map("vat_amount")       // 12% VAT amount
  vatExemptSales  Decimal     @default(0) @db.Decimal(10, 2) @map("vat_exempt_sales") // VAT-exempt sales
  zeroRatedSales  Decimal     @default(0) @db.Decimal(10, 2) @map("zero_rated_sales") // Zero-rated sales

  // Customer Info
  customerName    String?     @map("customer_name")
  customerPhone   String?     @map("customer_phone")

  // B2B Customer Info (for claiming input tax)
  customerTin             String?   @map("customer_tin") @db.VarChar(20)           // Customer's TIN
  customerBusinessName    String?   @map("customer_business_name") @db.VarChar(255)
  customerBusinessAddress String?   @map("customer_business_address") @db.Text

  notes           String?     @db.Text
  posCreatedAt    DateTime    @map("pos_created_at") // When order was created on POS
  posClosedAt     DateTime?   @map("pos_closed_at") // When order was closed on POS
  syncedAt        DateTime    @default(now()) @map("synced_at") // When synced to backend
  syncBatchId     String?     @map("sync_batch_id") // Batch identifier for sync tracking
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  // Relations
  posDevice  PosDevice       @relation(fields: [posDeviceId], references: [id])
  shift      Shift?          @relation(fields: [shiftId], references: [id])
  orderItems OrderItem[]
  discounts  OrderDiscount[]
  payments   Payment[]
  refunds    Refund[]

  @@unique([posDeviceId, posOrderId]) // Idempotency constraint
  @@index([branchId])
  @@index([storeId])
  @@index([shiftId])
  @@index([invoiceNumber])
  @@index([posCreatedAt])
  @@index([syncBatchId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id            String   @id @default(uuid())
  orderId       String   @map("order_id")
  posItemId     String?  @map("pos_item_id") // Reference to item in POS (may not exist in backend)
  itemId        String?  @map("item_id") // Reference to Item if exists
  itemName      String   @map("item_name") // Denormalized for historical accuracy
  itemSku       String?  @map("item_sku")
  quantity      Int
  unitPrice     Decimal  @db.Decimal(10, 2) @map("unit_price")
  discountAmount Decimal @default(0) @db.Decimal(10, 2) @map("discount_amount")
  taxAmount     Decimal  @default(0) @db.Decimal(10, 2) @map("tax_amount")
  totalPrice    Decimal  @db.Decimal(10, 2) @map("total_price")
  notes         String?  @db.Text
  isVoided      Boolean  @default(false) @map("is_voided")
  voidReason    String?  @map("void_reason")
  createdAt     DateTime @default(now()) @map("created_at")

  // Relations
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item      Item?           @relation(fields: [itemId], references: [id], onDelete: SetNull)
  discounts OrderDiscount[]

  @@index([orderId])
  @@index([itemId])
  @@map("order_items")
}

model OrderDiscount {
  id            String        @id @default(uuid())
  orderId       String        @map("order_id")
  orderItemId   String?       @map("order_item_id") // Null if order-level discount
  discountName  String        @map("discount_name")
  discountType  DiscountType  @map("discount_type")
  discountScope DiscountScope @map("discount_scope")
  discountValue Decimal       @db.Decimal(10, 2) @map("discount_value") // Percentage or fixed amount
  discountAmount Decimal      @db.Decimal(10, 2) @map("discount_amount") // Actual amount discounted
  reason        String?
  appliedBy     String?       @map("applied_by") // User who applied discount
  createdAt     DateTime      @default(now()) @map("created_at")

  // Relations
  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([orderItemId])
  @@map("order_discounts")
}

model Payment {
  id              String        @id @default(uuid())
  posPaymentId    String        @map("pos_payment_id") // Unique ID from POS
  orderId         String        @map("order_id")
  paymentMethod   PaymentMethod @map("payment_method")
  status          PaymentStatus @default(COMPLETED)
  amount          Decimal       @db.Decimal(10, 2)
  tipAmount       Decimal       @default(0) @db.Decimal(10, 2) @map("tip_amount")
  changeAmount    Decimal       @default(0) @db.Decimal(10, 2) @map("change_amount") // For cash payments
  referenceNumber String?       @map("reference_number") // Card last 4 digits, transaction ID, etc.
  processedAt     DateTime      @map("processed_at")
  createdAt       DateTime      @default(now()) @map("created_at")

  // Relations
  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds Refund[]

  @@unique([orderId, posPaymentId])
  @@index([orderId])
  @@index([paymentMethod])
  @@map("payments")
}

model Refund {
  id            String        @id @default(uuid())
  posRefundId   String        @map("pos_refund_id") // Unique ID from POS
  orderId       String        @map("order_id")
  paymentId     String?       @map("payment_id") // Original payment being refunded
  amount        Decimal       @db.Decimal(10, 2)
  reason        String?
  refundMethod  PaymentMethod @map("refund_method") // How refund was issued
  processedBy   String?       @map("processed_by") // User who processed refund
  processedAt   DateTime      @map("processed_at")
  createdAt     DateTime      @default(now()) @map("created_at")

  // Relations
  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([orderId, posRefundId])
  @@index([orderId])
  @@index([paymentId])
  @@map("refunds")
}

// =====================
// Shifts & Cash Management (Synced from POS)
// =====================

enum ShiftStatus {
  OPEN
  CLOSED
}

model Shift {
  id            String      @id @default(uuid())
  posShiftId    String      @map("pos_shift_id") // Unique ID from POS for idempotency
  posDeviceId   String      @map("pos_device_id")
  branchId      String      @map("branch_id")
  storeId       String      @map("store_id")
  operatorId    String?     @map("operator_id") // Portal user ID (resolved from posOperatorId)
  posOperatorId String      @map("pos_operator_id") // POS user ID
  status        ShiftStatus @default(OPEN)
  openedAt      DateTime    @map("opened_at")
  closedAt      DateTime?   @map("closed_at")
  openingCash   Decimal     @db.Decimal(10, 2) @map("opening_cash")
  closingCash   Decimal?    @db.Decimal(10, 2) @map("closing_cash")
  expectedCash  Decimal?    @db.Decimal(10, 2) @map("expected_cash")
  variance      Decimal?    @db.Decimal(10, 2)
  notes         String?     @db.Text
  orderCount    Int         @default(0) @map("order_count")
  syncedAt      DateTime    @default(now()) @map("synced_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  // Relations
  posDevice     PosDevice      @relation(fields: [posDeviceId], references: [id])
  operator      User?          @relation(fields: [posOperatorId], references: [id])
  cashMovements CashMovement[]
  orders        Order[]

  @@unique([posDeviceId, posShiftId]) // Idempotency constraint
  @@index([branchId])
  @@index([storeId])
  @@index([operatorId])
  @@index([posOperatorId])
  @@index([status])
  @@index([openedAt])
  @@map("shifts")
}

enum CashMovementType {
  OPENING_FLOAT
  CASH_SALE
  CHANGE_GIVEN
  TIP_CASH
  PAID_OUT
  DROP
  CASH_IN
  REFUND
  CLOSING_COUNT
}

model CashMovement {
  id            String           @id @default(uuid())
  shiftId       String           @map("shift_id")
  movementType  CashMovementType @map("movement_type")
  amount        Decimal          @db.Decimal(10, 2)
  referenceType String?          @map("reference_type")
  referenceId   String?          @map("reference_id")
  reason        String?          @db.Text
  performedBy   String           @map("performed_by")
  performedAt   DateTime         @map("performed_at")
  createdAt     DateTime         @default(now()) @map("created_at")

  // Relations
  shift         Shift            @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([shiftId])
  @@map("cash_movements")
}

// =====================
// BIR Compliance - Z-Reading
// =====================

model ZReading {
  id                    String    @id @default(uuid())
  posDeviceId           String    @map("pos_device_id")
  branchId              String    @map("branch_id")
  storeId               String    @map("store_id")
  posZReadingId         String?   @map("pos_z_reading_id") // ID from POS for idempotency

  // Z-Counter (Non-resettable, increments daily)
  zCounterNo            Int       @map("z_counter_no")

  // Invoice Range
  beginningInvoiceNo    String    @map("beginning_invoice_no") @db.VarChar(20)
  endingInvoiceNo       String    @map("ending_invoice_no") @db.VarChar(20)

  // Grand Total Tracking (Non-resettable)
  beginningGrandTotal   Decimal   @map("beginning_grand_total") @db.Decimal(15, 2)
  endingGrandTotal      Decimal   @map("ending_grand_total") @db.Decimal(15, 2)

  // Daily Sales Summary
  grossSales            Decimal   @map("gross_sales") @db.Decimal(15, 2)
  netSales              Decimal   @map("net_sales") @db.Decimal(15, 2)
  vatableSales          Decimal   @map("vatable_sales") @db.Decimal(15, 2)
  vatAmount             Decimal   @map("vat_amount") @db.Decimal(15, 2)
  vatExemptSales        Decimal   @map("vat_exempt_sales") @db.Decimal(15, 2)
  zeroRatedSales        Decimal   @map("zero_rated_sales") @db.Decimal(15, 2)

  // Adjustments
  discountTotal         Decimal   @default(0) @map("discount_total") @db.Decimal(15, 2)
  refundTotal           Decimal   @default(0) @map("refund_total") @db.Decimal(15, 2)
  voidTotal             Decimal   @default(0) @map("void_total") @db.Decimal(15, 2)

  // Transaction Counts
  transactionCount      Int       @map("transaction_count")
  voidCount             Int       @default(0) @map("void_count")
  refundCount           Int       @default(0) @map("refund_count")

  // Metadata
  closedBy              String    @map("closed_by") // User who closed the day
  closedAt              DateTime  @map("closed_at")
  syncedAt              DateTime  @default(now()) @map("synced_at")
  createdAt             DateTime  @default(now()) @map("created_at")

  // Relations
  posDevice             PosDevice @relation(fields: [posDeviceId], references: [id])

  @@unique([posDeviceId, posZReadingId])
  @@unique([posDeviceId, zCounterNo]) // Only one Z-reading per day per device
  @@index([branchId])
  @@index([storeId])
  @@index([closedAt])
  @@map("z_readings")
}

// =====================
// BIR Compliance - Electronic Journal
// =====================

model ElectronicJournal {
  id                String    @id @default(uuid())
  posDeviceId       String    @map("pos_device_id")
  branchId          String    @map("branch_id")
  storeId           String    @map("store_id")

  // Transaction Reference
  orderId           String?   @map("order_id")
  invoiceNumber     String    @map("invoice_number") @db.VarChar(20)
  transactionType   String    @map("transaction_type") @db.VarChar(20) // SALE, VOID, REFUND

  // Receipt Content (Read-only, immutable record)
  receiptContent    String    @map("receipt_content") @db.Text // Full receipt text/JSON
  receiptHash       String    @map("receipt_hash") @db.VarChar(64) // SHA-256 hash for integrity

  // Amounts
  grandTotal        Decimal   @map("grand_total") @db.Decimal(10, 2)
  vatAmount         Decimal   @map("vat_amount") @db.Decimal(10, 2)

  // Operator Info
  operatorId        String    @map("operator_id")
  operatorName      String    @map("operator_name") @db.VarChar(100)

  // Timestamps
  transactionDate   DateTime  @map("transaction_date")
  syncedAt          DateTime  @default(now()) @map("synced_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  @@index([posDeviceId])
  @@index([branchId])
  @@index([storeId])
  @@index([invoiceNumber])
  @@index([transactionDate])
  @@map("electronic_journal")
}

// =====================
// Inventory Management
// =====================

enum MovementType {
  RECEIVED
  SOLD
  ADJUSTED_UP
  ADJUSTED_DOWN
  WASTED
  VOIDED_SALE
  REFUNDED
  TRANSFER_IN
  TRANSFER_OUT
}

model BranchInventory {
  id                String   @id @default(uuid())
  itemId            String   @map("item_id")
  branchId          String   @map("branch_id")
  storeId           String   @map("store_id")
  currentQuantity   Int      @default(0) @map("current_quantity")
  lowStockThreshold Int?     @map("low_stock_threshold")
  isTracked         Boolean  @default(true) @map("is_tracked")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relations
  item      Item                @relation(fields: [itemId], references: [id], onDelete: Cascade)
  branch    Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  movements InventoryMovement[]

  @@unique([itemId, branchId])
  @@index([branchId])
  @@index([storeId])
  @@map("branch_inventory")
}

model InventoryMovement {
  id                String       @id @default(uuid())
  movementId        String       @unique @map("movement_id") // Unique ID for idempotent sync
  branchInventoryId String       @map("branch_inventory_id")
  itemId            String       @map("item_id")
  branchId          String       @map("branch_id")
  storeId           String       @map("store_id")
  movementType      MovementType @map("movement_type")
  quantity          Int
  previousQuantity  Int          @map("previous_quantity")
  newQuantity       Int          @map("new_quantity")
  referenceType     String?      @map("reference_type") // ORDER, REFUND, ADJUSTMENT, etc.
  referenceId       String?      @map("reference_id")
  posDeviceId       String?      @map("pos_device_id")
  reason            String?      @db.Text
  performedBy       String?      @map("performed_by")
  performedAt       DateTime     @map("performed_at")
  syncedAt          DateTime?    @map("synced_at")
  createdAt         DateTime     @default(now()) @map("created_at")

  // Relations
  branchInventory BranchInventory @relation(fields: [branchInventoryId], references: [id], onDelete: Cascade)

  @@index([branchInventoryId])
  @@index([itemId])
  @@index([branchId])
  @@index([movementType])
  @@index([performedAt])
  @@map("inventory_movements")
}

// =====================
// Alerts & Exception Monitoring
// =====================

enum AlertType {
  ZERO_SALES_BRANCH
  EXCESSIVE_VOID_REFUND
  INVENTORY_ANOMALY
  POS_SYNC_FAILURE
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

model Alert {
  id             String        @id @default(uuid())
  storeId        String        @map("store_id")
  type           AlertType
  severity       AlertSeverity
  title          String        @db.VarChar(255)
  message        String        @db.Text
  metadata       Json?
  acknowledgedAt DateTime?     @map("acknowledged_at")
  acknowledgedBy String?       @map("acknowledged_by")
  dismissedAt    DateTime?     @map("dismissed_at")
  dismissedBy    String?       @map("dismissed_by")
  resolvedAt     DateTime?     @map("resolved_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@index([storeId])
  @@index([type])
  @@index([severity])
  @@index([createdAt])
  @@index([storeId, type, createdAt])
  @@map("alerts")
}

model AlertConfig {
  id              String    @id @default(uuid())
  storeId         String    @map("store_id")
  alertType       AlertType @map("alert_type")
  enabled         Boolean   @default(true)
  thresholds      Json?
  cooldownMinutes Int       @default(60) @map("cooldown_minutes")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@unique([storeId, alertType])
  @@map("alert_configs")
}

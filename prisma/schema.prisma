// POS Portal Backend - Prisma Schema
// Phase 1: Authentication, RBAC, Stores, Branches, Items, POS, Sync

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// =====================
// User & Authentication
// =====================

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  firstName    String    @map("first_name")
  lastName     String    @map("last_name")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  // Relations
  storeUsers    StoreUser[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique @db.VarChar(500)
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  isRevoked Boolean  @default(false) @map("is_revoked")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

// =====================
// RBAC - Roles & Permissions
// =====================

model Role {
  id          String    @id @default(uuid())
  name        String
  description String?   @db.Text
  storeId     String    @map("store_id")
  isSystem    Boolean   @default(false) @map("is_system")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  // Relations
  store           Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  storeUsers      StoreUser[]

  @@unique([storeId, name])
  @@index([storeId])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?  @db.Text
  module      String
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  rolePermissions RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// =====================
// Store (Multi-Tenant)
// =====================

enum StoreType {
  RESTAURANT
  RETAIL
  CAFE
  OTHER
}

enum StoreStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Store {
  id        String      @id @default(uuid())
  name      String
  type      StoreType   @default(OTHER)
  status    StoreStatus @default(ACTIVE)
  address   String?     @db.Text
  phone     String?
  email     String?
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  deletedAt DateTime?   @map("deleted_at")

  // Relations
  branches   Branch[]
  storeUsers StoreUser[]
  roles      Role[]
  items      Item[]
  categories Category[]
  auditLogs  AuditLog[]

  @@map("stores")
}

model StoreUser {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  storeId   String    @map("store_id")
  roleId    String    @map("role_id")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  role  Role  @relation(fields: [roleId], references: [id])

  @@unique([userId, storeId])
  @@index([storeId])
  @@index([roleId])
  @@map("store_users")
}

// =====================
// Branches
// =====================

enum BranchStatus {
  ONLINE
  OFFLINE
  MAINTENANCE
}

model Branch {
  id           String       @id @default(uuid())
  storeId      String       @map("store_id")
  name         String
  address      String?      @db.Text
  phone        String?
  status       BranchStatus @default(OFFLINE)
  lastSyncAt   DateTime?    @map("last_sync_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  deletedAt    DateTime?    @map("deleted_at")

  // Relations
  store         Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  posDevices    PosDevice[]
  itemBranches  ItemBranch[]

  @@index([storeId])
  @@map("branches")
}

// =====================
// Items (with Versioning)
// =====================

model Category {
  id          String    @id @default(uuid())
  storeId     String    @map("store_id")
  name        String
  description String?   @db.Text
  sortOrder   Int       @default(0) @map("sort_order")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  // Relations
  store Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items Item[]

  @@unique([storeId, name])
  @@index([storeId])
  @@map("categories")
}

model Item {
  id          String    @id @default(uuid())
  storeId     String    @map("store_id")
  categoryId  String?   @map("category_id")
  sku         String?
  name        String
  description String?   @db.Text
  price       Decimal   @db.Decimal(10, 2)
  isActive    Boolean   @default(true) @map("is_active")
  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  // Relations
  store        Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category     Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  itemBranches ItemBranch[]
  itemVersions ItemVersion[]
  orderItems   OrderItem[]

  @@unique([storeId, sku])
  @@index([storeId])
  @@index([categoryId])
  @@map("items")
}

model ItemVersion {
  id          String   @id @default(uuid())
  itemId      String   @map("item_id")
  version     Int
  name        String
  description String?  @db.Text
  price       Decimal  @db.Decimal(10, 2)
  changedBy   String?  @map("changed_by")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, version])
  @@index([itemId])
  @@map("item_versions")
}

model ItemBranch {
  id          String   @id @default(uuid())
  itemId      String   @map("item_id")
  branchId    String   @map("branch_id")
  isAvailable Boolean  @default(true) @map("is_available")
  customPrice Decimal? @db.Decimal(10, 2) @map("custom_price")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([itemId, branchId])
  @@index([branchId])
  @@map("item_branches")
}

// =====================
// POS Device Management
// =====================

enum PosStatus {
  ONLINE
  OFFLINE
  INACTIVE
}

model PosDevice {
  id                        String    @id @default(uuid())
  branchId                  String    @map("branch_id")
  deviceIdentifier          String?   @unique @map("device_identifier")
  name                      String?
  appVersion                String?   @map("app_version")
  status                    PosStatus @default(OFFLINE)
  lastHeartbeatAt           DateTime? @map("last_heartbeat_at")
  lastSyncAt                DateTime? @map("last_sync_at")
  tokenHash                 String?   @map("token_hash")
  tokenExpiresAt            DateTime? @map("token_expires_at")
  // Registration code fields
  registrationCode          String?   @unique @map("registration_code")
  registrationCodeExpiresAt DateTime? @map("registration_code_expires_at")
  isRegistered              Boolean   @default(false) @map("is_registered")
  registeredAt              DateTime? @map("registered_at")
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")
  deletedAt                 DateTime? @map("deleted_at")

  // Relations
  branch   Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  syncLogs SyncLog[]
  orders   Order[]

  @@index([branchId])
  @@index([registrationCode])
  @@map("pos_devices")
}

// =====================
// Sync Module
// =====================

enum SyncType {
  CONFIG
  ITEMS
  CATEGORIES
  FULL
  HEARTBEAT
}

enum SyncStatus {
  SUCCESS
  FAILED
  PARTIAL
}

model SyncLog {
  id          String     @id @default(uuid())
  posDeviceId String     @map("pos_device_id")
  syncType    SyncType   @map("sync_type")
  status      SyncStatus
  version     Int?
  itemCount   Int?       @map("item_count")
  errorMsg    String?    @db.Text @map("error_msg")
  startedAt   DateTime   @map("started_at")
  completedAt DateTime?  @map("completed_at")
  createdAt   DateTime   @default(now()) @map("created_at")

  // Relations
  posDevice PosDevice @relation(fields: [posDeviceId], references: [id], onDelete: Cascade)

  @@index([posDeviceId])
  @@index([syncType])
  @@index([createdAt])
  @@map("sync_logs")
}

// =====================
// Audit Logging
// =====================

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  SYNC
  REGISTER
}

model AuditLog {
  id         String      @id @default(uuid())
  userId     String?     @map("user_id")
  storeId    String?     @map("store_id")
  action     AuditAction
  entityType String      @map("entity_type")
  entityId   String?     @map("entity_id")
  oldValue   Json?       @map("old_value")
  newValue   Json?       @map("new_value")
  ipAddress  String?     @map("ip_address")
  userAgent  String?     @db.Text @map("user_agent")
  createdAt  DateTime    @default(now()) @map("created_at")

  // Relations
  user  User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  store Store? @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([storeId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
  @@map("audit_logs")
}

// =====================
// Sales Module (POS → Backend Sync)
// =====================

enum OrderStatus {
  PENDING
  COMPLETED
  VOIDED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum OrderType {
  DINE_IN
  TAKEOUT
  DELIVERY
  DRIVE_THRU
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  MOBILE_PAYMENT
  GIFT_CARD
  STORE_CREDIT
  OTHER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum DiscountScope {
  ORDER
  ITEM
}

model Order {
  id              String      @id @default(uuid())
  posOrderId      String      @map("pos_order_id") // Unique ID from POS for idempotency
  posDeviceId     String      @map("pos_device_id")
  branchId        String      @map("branch_id")
  storeId         String      @map("store_id")
  orderNumber     String      @map("order_number") // Human-readable order number
  orderType       OrderType   @default(DINE_IN) @map("order_type")
  status          OrderStatus @default(COMPLETED)
  subtotal        Decimal     @db.Decimal(10, 2)
  discountTotal   Decimal     @default(0) @db.Decimal(10, 2) @map("discount_total")
  taxTotal        Decimal     @default(0) @db.Decimal(10, 2) @map("tax_total")
  grandTotal      Decimal     @db.Decimal(10, 2) @map("grand_total")
  customerName    String?     @map("customer_name")
  customerPhone   String?     @map("customer_phone")
  notes           String?     @db.Text
  posCreatedAt    DateTime    @map("pos_created_at") // When order was created on POS
  posClosedAt     DateTime?   @map("pos_closed_at") // When order was closed on POS
  syncedAt        DateTime    @default(now()) @map("synced_at") // When synced to backend
  syncBatchId     String?     @map("sync_batch_id") // Batch identifier for sync tracking
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  // Relations
  posDevice  PosDevice       @relation(fields: [posDeviceId], references: [id])
  orderItems OrderItem[]
  discounts  OrderDiscount[]
  payments   Payment[]
  refunds    Refund[]

  @@unique([posDeviceId, posOrderId]) // Idempotency constraint
  @@index([branchId])
  @@index([storeId])
  @@index([posCreatedAt])
  @@index([syncBatchId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id            String   @id @default(uuid())
  orderId       String   @map("order_id")
  posItemId     String?  @map("pos_item_id") // Reference to item in POS (may not exist in backend)
  itemId        String?  @map("item_id") // Reference to Item if exists
  itemName      String   @map("item_name") // Denormalized for historical accuracy
  itemSku       String?  @map("item_sku")
  quantity      Int
  unitPrice     Decimal  @db.Decimal(10, 2) @map("unit_price")
  discountAmount Decimal @default(0) @db.Decimal(10, 2) @map("discount_amount")
  taxAmount     Decimal  @default(0) @db.Decimal(10, 2) @map("tax_amount")
  totalPrice    Decimal  @db.Decimal(10, 2) @map("total_price")
  notes         String?  @db.Text
  isVoided      Boolean  @default(false) @map("is_voided")
  voidReason    String?  @map("void_reason")
  createdAt     DateTime @default(now()) @map("created_at")

  // Relations
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item      Item?           @relation(fields: [itemId], references: [id], onDelete: SetNull)
  discounts OrderDiscount[]

  @@index([orderId])
  @@index([itemId])
  @@map("order_items")
}

model OrderDiscount {
  id            String        @id @default(uuid())
  orderId       String        @map("order_id")
  orderItemId   String?       @map("order_item_id") // Null if order-level discount
  discountName  String        @map("discount_name")
  discountType  DiscountType  @map("discount_type")
  discountScope DiscountScope @map("discount_scope")
  discountValue Decimal       @db.Decimal(10, 2) @map("discount_value") // Percentage or fixed amount
  discountAmount Decimal      @db.Decimal(10, 2) @map("discount_amount") // Actual amount discounted
  reason        String?
  appliedBy     String?       @map("applied_by") // User who applied discount
  createdAt     DateTime      @default(now()) @map("created_at")

  // Relations
  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([orderItemId])
  @@map("order_discounts")
}

model Payment {
  id              String        @id @default(uuid())
  posPaymentId    String        @map("pos_payment_id") // Unique ID from POS
  orderId         String        @map("order_id")
  paymentMethod   PaymentMethod @map("payment_method")
  status          PaymentStatus @default(COMPLETED)
  amount          Decimal       @db.Decimal(10, 2)
  tipAmount       Decimal       @default(0) @db.Decimal(10, 2) @map("tip_amount")
  changeAmount    Decimal       @default(0) @db.Decimal(10, 2) @map("change_amount") // For cash payments
  referenceNumber String?       @map("reference_number") // Card last 4 digits, transaction ID, etc.
  processedAt     DateTime      @map("processed_at")
  createdAt       DateTime      @default(now()) @map("created_at")

  // Relations
  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds Refund[]

  @@unique([orderId, posPaymentId])
  @@index([orderId])
  @@index([paymentMethod])
  @@map("payments")
}

model Refund {
  id            String        @id @default(uuid())
  posRefundId   String        @map("pos_refund_id") // Unique ID from POS
  orderId       String        @map("order_id")
  paymentId     String?       @map("payment_id") // Original payment being refunded
  amount        Decimal       @db.Decimal(10, 2)
  reason        String?
  refundMethod  PaymentMethod @map("refund_method") // How refund was issued
  processedBy   String?       @map("processed_by") // User who processed refund
  processedAt   DateTime      @map("processed_at")
  createdAt     DateTime      @default(now()) @map("created_at")

  // Relations
  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([orderId, posRefundId])
  @@index([orderId])
  @@index([paymentId])
  @@map("refunds")
}

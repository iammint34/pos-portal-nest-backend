// POS Portal Backend - Item & Category Models
// Product catalog with versioning

model Category {
  id          String    @id @default(uuid())
  storeId     String    @map("store_id")
  name        String
  description String?   @db.Text
  sortOrder   Int       @default(0) @map("sort_order")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  // Relations
  store Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items Item[]

  @@unique([storeId, name])
  @@index([storeId])
  @@map("categories")
}

model Item {
  id          String    @id @default(uuid())
  storeId     String    @map("store_id")
  categoryId  String?   @map("category_id")
  sku         String?
  name        String
  description String?   @db.Text
  price       Decimal   @db.Decimal(10, 2)
  costPrice   Decimal?  @map("cost_price") @db.Decimal(10, 2) // For margin calculation in Menu Analytics
  isActive    Boolean   @default(true) @map("is_active")
  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  // Relations
  store           Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category        Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  itemBranches    ItemBranch[]
  itemVersions    ItemVersion[]
  orderItems      OrderItem[]
  branchInventory BranchInventory[]

  @@unique([storeId, sku])
  @@index([storeId])
  @@index([categoryId])
  @@map("items")
}

model ItemVersion {
  id          String   @id @default(uuid())
  itemId      String   @map("item_id")
  version     Int
  name        String
  description String?  @db.Text
  price       Decimal  @db.Decimal(10, 2)
  changedBy   String?  @map("changed_by")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, version])
  @@index([itemId])
  @@map("item_versions")
}

model ItemBranch {
  id          String   @id @default(uuid())
  itemId      String   @map("item_id")
  branchId    String   @map("branch_id")
  isAvailable Boolean  @default(true) @map("is_available")
  customPrice Decimal? @map("custom_price") @db.Decimal(10, 2)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([itemId, branchId])
  @@index([branchId])
  @@map("item_branches")
}

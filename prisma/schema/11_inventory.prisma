// POS Portal Backend - Inventory Models
// Stock tracking and movement history

model BranchInventory {
  id                String   @id @default(uuid())
  itemId            String   @map("item_id")
  branchId          String   @map("branch_id")
  storeId           String   @map("store_id")
  currentQuantity   Int      @default(0) @map("current_quantity")
  lowStockThreshold Int?     @map("low_stock_threshold")
  isTracked         Boolean  @default(true) @map("is_tracked")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relations
  item      Item                @relation(fields: [itemId], references: [id], onDelete: Cascade)
  branch    Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  movements InventoryMovement[]

  @@unique([itemId, branchId])
  @@index([branchId])
  @@index([storeId])
  @@map("branch_inventory")
}

model InventoryMovement {
  id                String       @id @default(uuid())
  movementId        String       @unique @map("movement_id")
  branchInventoryId String       @map("branch_inventory_id")
  itemId            String       @map("item_id")
  branchId          String       @map("branch_id")
  storeId           String       @map("store_id")
  movementType      MovementType @map("movement_type")
  quantity          Int
  previousQuantity  Int          @map("previous_quantity")
  newQuantity       Int          @map("new_quantity")
  referenceType     String?      @map("reference_type")
  referenceId       String?      @map("reference_id")
  posDeviceId       String?      @map("pos_device_id")
  reason            String?      @db.Text
  performedBy       String?      @map("performed_by")
  performedAt       DateTime     @map("performed_at")
  syncedAt          DateTime?    @map("synced_at")
  createdAt         DateTime     @default(now()) @map("created_at")

  // Relations
  branchInventory BranchInventory @relation(fields: [branchInventoryId], references: [id], onDelete: Cascade)

  @@index([branchInventoryId])
  @@index([itemId])
  @@index([branchId])
  @@index([movementType])
  @@index([performedAt])
  @@map("inventory_movements")
}

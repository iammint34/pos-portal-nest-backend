// POS Portal Backend - Feature Flag Models
// Store-scoped feature toggles for safe rollout

model StoreFeature {
  id         String     @id @default(uuid())
  storeId    String     @map("store_id")
  featureKey FeatureKey @map("feature_key")
  enabled    Boolean    @default(false)
  config     Json? // Feature-specific configuration
  enabledAt  DateTime?  @map("enabled_at")
  enabledBy  String?    @map("enabled_by")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  // Relations
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, featureKey])
  @@index([storeId])
  @@index([featureKey])
  @@map("store_features")
}

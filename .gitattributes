# Auto detect text files and perform LF normalization
* text=auto

# Force LF for specific files
*.ts text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
.gitignore text eol=lf
.env* text eol=lf

# Documents
*.sql text eol=lf

# Scripts
*.sh text eol=lf

# These files are binary and should be left untouched
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
